@@ -149,8 +151,45 @@ class Parser(object):
         return ast.literal(token['value'])
 
     def _token_nud_unquoted_identifier(self, token):
+        # ``let`` is a contextual keyword: it starts a let expression only
+        # when immediately followed by a variable binding, and is an
+        # ordinary field name everywhere else (JEP-11a).
+        if token['value'] == 'let' and self._current_token() == 'variable':
+            return self._parse_let_expression()
         return ast.field(token['value'])
 
+    def _token_nud_variable(self, token):
+        # Strip the leading '$'.
+        return ast.variable_ref(token['value'][1:])
+
+    def _parse_let_expression(self):
+        # We are here:   let $x = <expr> [, $y = <expr>]* in <expr>
+        #                    ^ current token
+        bindings = []
+        while True:
+            var_token = self._lookahead_token(0)
+            self._match('variable')
+            self._match('assign')
+            # Binding power 0: the binding expression stops at ',' and at
+            # the ``in`` identifier (both have binding power 0).
+            expression = self._expression(0)
+            bindings.append(ast.assign(var_token['value'][1:], expression))
+            if self._current_token() == 'comma':
+                self._advance()
+                continue
+            break
+        self._match_keyword('in')
+        body = self._expression(0)
+        return ast.let_expression(bindings, body)
+
+    def _match_keyword(self, keyword):
+        token = self._lookahead_token(0)
+        if token['type'] == 'unquoted_identifier' and \
+                token['value'] == keyword:
+            self._advance()
+        else:
+            self._raise_parse_error_maybe_eof(keyword, token)
+
     def _token_nud_quoted_identifier(self, token):
         field = ast.field(token['value'])
         # You can't have a quoted identifier as a function

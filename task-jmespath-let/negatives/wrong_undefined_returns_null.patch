+    def visit_let_expression(self, node, value):
+        *bindings, body = node['children']
+        # All binding expressions are evaluated against the *current* node
+        # and in the *enclosing* scope: the new scope is pushed only after
+        # every binding has been evaluated, so bindings cannot see their
+        # siblings.
+        scope = {}
+        for binding in bindings:
+            scope[binding['value']] = self.visit(binding['children'][0], value)
+        self._scopes.append(scope)
+        try:
+            return self.visit(body, value)
+        finally:
+            self._scopes.pop()
+
+    def visit_variable_ref(self, node, value):
+        name = node['value']
+        for scope in reversed(self._scopes):
+            if name in scope:
+                return scope[name]
+        # Unbound names resolve like missing keys do.
+        return None
+
     def visit_identity(self, node, value):
         return value
 

diff --git a/jmespath/ast.py b/jmespath/ast.py
index dd56c6e..adf8826 100644
--- a/jmespath/ast.py
+++ b/jmespath/ast.py
@@ -62,6 +62,20 @@ def or_expression(left, right):
     return {"type": "or_expression", "children": [left, right]}
 
 
+def assign(name, expr):
+    # One ``$name = expr`` binding inside a let expression.
+    return {'type': 'assign', 'children': [expr], 'value': name}
+
+
+def let_expression(bindings, expr):
+    # children = [assign, assign, ..., body]
+    return {'type': 'let_expression', 'children': list(bindings) + [expr]}
+
+
+def variable_ref(name):
+    return {'type': 'variable_ref', 'children': [], 'value': name}
+
+
 def and_expression(left, right):
     return {"type": "and_expression", "children": [left, right]}
 
diff --git a/jmespath/exceptions.py b/jmespath/exceptions.py
index 0156015..a8b15ec 100644
--- a/jmespath/exceptions.py
+++ b/jmespath/exceptions.py
@@ -120,3 +120,14 @@ class EmptyExpressionError(JMESPathError):
 
 class UnknownFunctionError(JMESPathError):
     pass
+
+
+class UndefinedVariable(JMESPathError):
+    """A ``$name`` reference was evaluated with no binding in scope.
+
+    Raised at evaluation time (never at compile time), per JEP-11a.
+    """
+    def __init__(self, varname):
+        self.varname = varname
+        super(UndefinedVariable, self).__init__(
+            "Reference to undefined variable: $%s" % varname)
